{
  "name": "signal-desk",
  "version": "0.1.0",
  "description": "Signal Desk 暖纸情报工作台",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node src/server/index.js --dev",
    "build": "vite build",
    "start": "node src/server/index.js",
    "app": "npm run build && electron .",
    "check": "node scripts/check.js",
    "smoke": "npm run build && node scripts/smoke.js",
    "smoke:desktop": "npm run build && electron . --smoke-test",
    "test": "node --test scripts/selectors.test.js tests/*.test.js",
    "format": "prettier --write \"src/client/**/*.{js,jsx,css}\" tailwind.config.js postcss.config.js",
    "format:check": "prettier --check \"src/client/**/*.{js,jsx,css}\" tailwind.config.js postcss.config.js"
  },
  "dependencies": {
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "rss-parser": "3.13.0"
  },
  "devDependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "electron": "44.2.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "vite": "8.2.2"
  }
}
